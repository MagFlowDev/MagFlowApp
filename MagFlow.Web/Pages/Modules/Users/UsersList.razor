@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CoreScope
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.BLL.Helpers.Localization.Display
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IUserService UserService
@inject ICompanyService CompanyService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_usersDataGrid" T="UserDTO" ServerData="ServerReloadUsers" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.USERS_LIST" OnRowClicked="OpenUserDetails" MultiSelection="true" DisableFiltering="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.UsersList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_EDIT">
            <Authorized>
                <LoadingButton Loading="_loadingBlockMany" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Block" Class="mr-2" OnClick="BlockUsers">@Localizer[Langs.Block]</LoadingButton>
                <LoadingButton Loading="_loadingUnblockMany" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.LockReset" Class="mr-2" OnClick="UnblockUsers">@Localizer[Langs.Unblock]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_DELETE">
            <Authorized>
                <LoadingButton Loading="_loadingDeleteMany" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Delete" Class="mr-2" OnClick="DeleteUsers">@Localizer[Langs.Delete]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_ADD">
            <Authorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mr-2" OnClick="OpenAddUserModal">@Localizer[Langs.AddUser]</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_usersDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="UserDTO" HeaderStyle="width: 1%" />
        <MagFlowTemplateColumn T="UserDTO" TFilter="string" Title="@Localizer[Langs.Status]">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Variant="Variant.Filled" Color="@(context.Item.IsActive? Color.Success: Color.Error)">@(context.Item.IsActive? Localizer[Langs.Active] : Localizer[Langs.Inactive])</MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="UserDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.FirstName]" Property="x => x.FirstName" MagFlowSortable="true" />
        <MagFlowPropertyColumn T="UserDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.LastName]" Property="x => x.LastName" MagFlowSortable="true" />
        <MagFlowTemplateColumn T="UserDTO" TFilter="string" Title="@Localizer[Langs.Email]" MagFlowSortable="true" Tag="@($"{nameof(UserDTO.Email)}")" PropertyExpression="x => x.Email">
            <CellTemplate>
                <MudLink Color="Color.Primary" OnClick="@(() => OpenUserDetails(context.Item))">@context.Item.Email</MudLink>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowTemplateColumn T="UserDTO" TFilter="string" Title="@Localizer[Langs.RoleSingle]">
            <CellTemplate>
                <MudText>@context.Item.Roles.FirstOrDefault()?.DisplayRole(Localizer)</MudText>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowTemplateColumn T="UserDTO" TFilter="string" Title="@Localizer[Langs.LastLogin]">
            <CellTemplate>
                <MudText>@context.Item.LastLogin?.ToLocalTime().ToString()</MudText>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowActionColumn T="UserDTO" Title="@Localizer[Langs.Actions]">
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_READ">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Open]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.OpenInNew" OnClick="() => OpenUserDetails(context.Item)"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_EDIT">
                    <Authorized Context="authorizedContext">
                        @if (context.Item.IsActive)
                        {
                            <MudTooltip Text="@Localizer[Langs.Block]" Delay="@Constants.Tooltip.DELAY">
                                <LoadingIconButton Loading="LoadingBlock(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.Block" OnClick="() => BlockUser(context.Item)"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@Localizer[Langs.Unblock]" Delay="@Constants.Tooltip.DELAY">
                                <LoadingIconButton Loading="LoadingBlock(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.LockReset" OnClick="() => UnblockUser(context.Item)"/>
                            </MudTooltip>
                        }
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.USERS_DELETE">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Delete]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingDelete(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => DeleteUser(context.Item)"/>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>
