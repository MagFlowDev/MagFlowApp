@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IContractorService ContractorService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_contractorsDataGrid" T="ContractorDTO" ServerData="ServerReloadContractors" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.CONTRACTORS_LIST" OnRowClicked="OpenContractorDetails" MultiSelection="true" SelectedItemsChanged="@((HashSet<ContractorDTO> _) => StateHasChanged())">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.ContractorsList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_EDIT">
            <Authorized>
                <MudButtonGroup Variant="Variant.Filled" Class="mr-2" Color="Color.Secondary">
                    <MudButton Disabled="@StatusChangeDisabled"
                               OnClick="() => ChangeSelectedStatuses(_targetStatus)">
                        @Localizer[IsActivationSelected ? Langs.Activate : Langs.Deactivate]
                    </MudButton>
                    <MudMenu Disabled="@_isBusy">
                        <ActivatorContent Context="menu">
                            <MudButton Variant="Variant.Filled" Disabled="@_isBusy"
                                       Style="width: 30px; min-width: 30px; padding-inline: 0"
                                       aria-label="@Localizer[Langs.ChangeStatus]" OnClick="@menu.ToggleAsync">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" />
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="ToggleStatusAction">
                                @Localizer[IsActivationSelected ? Langs.Deactivate : Langs.Activate]
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </MudButtonGroup>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_DELETE">
            <Authorized>
                <LoadingButton Loading="_loadingDeleteMany"
                               Disabled="@(_isBusy || _contractorsDataGrid?.Selection?.Any() != true)"
                               Color="Color.Error" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Outlined.Delete" Class="mr-2" OnClick="DeleteContractors">
                    @Localizer[Langs.Delete]
                </LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_ADD">
            <Authorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mr-2" OnClick="OpenAddContractorDialog">@Localizer[Langs.AddContractor]</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="() => _contractorsDataGrid.ReloadServerData()"
                       Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" aria-label="@Localizer[Langs.Refresh]" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ContractorDTO" HeaderStyle="width: 1%" />
        <MagFlowTemplateColumn T="ContractorDTO" TFilter="Enums.EntityStatus"
                               Title="@Localizer[Langs.Status]" Tag="@(nameof(ContractorDTO.Status))"
                               IncludedEnumValues="@(new[] { Enums.EntityStatus.Unknown, Enums.EntityStatus.Active, Enums.EntityStatus.Inactive })">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Size="Size.Small"
                         Variant="Variant.Filled" Color="@context.Item.Status.ToColor()">
                    @context.Item.Status.GetDisplayName(Localizer)
                </MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string" TFilter="string"
                               Title="@Localizer[Langs.Name]" MagFlowSortable="true"
                               Property="contractor => contractor.Name" Tag="@(nameof(ContractorDTO.Name))" />
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string" TFilter="string"
                               Title="@Localizer[Langs.Code]" MagFlowSortable="true"
                               Property="contractor => contractor.Code" Tag="@(nameof(ContractorDTO.Code))" />
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string?" TFilter="string"
                               Title="@Localizer[Langs.TaxNumber]" MagFlowSortable="true"
                               Property="contractor => contractor.TaxNumber" Tag="@(nameof(ContractorDTO.TaxNumber))" />
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string?" TFilter="string"
                               Title="@Localizer[Langs.Address]" MagFlowSortable="true"
                               Property="contractor => contractor.Address" Tag="@(nameof(ContractorDTO.Address))">
            <CellTemplate>
                @{
                    var contractor = context.Item;
                    var locality = $"{contractor.PostalCode?.Trim()} {contractor.City?.Trim()}".Trim();
                    var address = string.Join(", ", new[] { contractor.Address?.Trim(), locality }
                        .Where(part => !string.IsNullOrWhiteSpace(part)));
                }
                @address
            </CellTemplate>
        </MagFlowPropertyColumn>
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string?" TFilter="string"
                               Title="@Localizer[Langs.Country]" MagFlowSortable="true"
                               Property="contractor => contractor.Country" Tag="@(nameof(ContractorDTO.Country))" />
        <MagFlowPropertyColumn T="ContractorDTO" TProperty="string?" TFilter="string"
                               Title="@Localizer[Langs.Phone]" MagFlowSortable="true"
                               Property="contractor => contractor.ContactPhone" Tag="@(nameof(ContractorDTO.ContactPhone))" />
        <MagFlowTemplateColumn T="ContractorDTO" TFilter="string"
                               Title="@Localizer[Langs.Email]" Tag="@(nameof(ContractorDTO.ContactEmail))">
            <CellTemplate>
                @if (!string.IsNullOrWhiteSpace(context.Item.ContactEmail))
                {
                    var email = context.Item.ContactEmail.Trim();
                    var address = Uri.EscapeDataString(email).Replace("%40", "@");
                    <MudLink Href="@($"mailto:{address}")">@email</MudLink>
                }
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowActionColumn T="ContractorDTO" Title="@Localizer[Langs.Actions]">
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_READ">
                    <Authorized Context="authorization">
                        <MudTooltip Text="@Localizer[Langs.Open]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.OpenInNew"
                                           OnClick="() => OpenContractorDetails(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_DELETE">
                    <Authorized Context="authorization">
                        <MudTooltip Text="@Localizer[Langs.Delete]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingDelete(context.Item.Id)" Size="Size.Small"
                                               Icon="@Icons.Material.Outlined.Delete"
                                               OnClick="() => DeleteContractor(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>