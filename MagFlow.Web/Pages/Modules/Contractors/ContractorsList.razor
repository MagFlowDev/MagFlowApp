@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IContractorService ContractorService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject ILocalCacheService LocalCacheService
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<h3>ContractorsList</h3>

<MagFlowDataGrid @ref="_contractorsDataGrid" T="ContractorDTO" ServerData="ServerReloadContractors" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.CONTRACTORS_LIST" OnRowClicked="OpenContractorDetails" MultiSelection="true" SelectedItemsChanged="@((HashSet<ContractorDTO> _) => StateHasChanged())">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.ContractorsList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_DELETE">
            <Authorized>
                <LoadingButton Loading="_loadingDeleteMany" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Delete" Class="mr-2" OnClick="DeleteContractors">@Localizer[Langs.Delete]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.CONTRACTORS_ADD">
            <Authorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mr-2" OnClick="OpenAddContractorWizard">@Localizer[Langs.AddContractor]</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_contractorsDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ContractorDTO" HeaderStyle="width: 1%" />
    </Columns>
</MagFlowDataGrid>