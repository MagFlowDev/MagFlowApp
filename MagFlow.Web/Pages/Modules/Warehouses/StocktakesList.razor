@using MagFlow.BLL.Helpers
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.DataGrid
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inherits AuthComponentBase

<AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_READ">
    <Authorized Context="readContext">
        <MagFlowDataGrid @ref="_stocktakesDataGrid" T="StocktakeDTO" ServerData="ServerReloadStocktakes" DataGridId="@GridId">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer[Langs.Inventories]</MudText>
                <MudSpacer />
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_ADD" Context="addContext">
                    <Authorized>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_openingDialog"
                                   OnClick="PrepareStocktake" Class="mr-2">@Localizer[Langs.StocktakePrepareTitle]</MudButton>
                    </Authorized>
                </AuthorizeView>
                <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Outlined.Refresh"
                               OnClick="Refresh" Class="mr-2" />
            </ToolBarContent>
            <Columns>
                <MagFlowPropertyColumn T="StocktakeDTO" TProperty="int" TFilter="int"
                                       Title="@Localizer[Langs.StocktakeNumber]" Property="x => x.Id" Tag="@("Id")" MagFlowSortable="true" />
                @if (!WarehouseId.HasValue)
                {
                    <MagFlowPropertyColumn T="StocktakeDTO" TProperty="string" TFilter="string"
                                           Title="@Localizer[Langs.WarehouseSelector]" Property="x => x.WarehouseName"
                                           Tag="@("Warehouse.Name")" MagFlowSortable="true" />
                }
                <MagFlowTemplateColumn T="StocktakeDTO" TFilter="Enums.StocktakeType"
                                       Title="@Localizer[Langs.StocktakeType]" Tag="@("Type")">
                    <CellTemplate>@context.Item.Type.GetDisplayName(Localizer)</CellTemplate>
                </MagFlowTemplateColumn>
                <MagFlowTemplateColumn T="StocktakeDTO" TFilter="Enums.EntityStatus" Title="@Localizer[Langs.Status]"
                                       Tag="@("Status")" IncludedEnumValues="@(new[] { Enums.EntityStatus.Prepared, Enums.EntityStatus.InProgress, Enums.EntityStatus.Confirmed, Enums.EntityStatus.Unknown })">
                    <CellTemplate>
                        <MudChip T="string" Color="Color.Info" Class="m-0">@context.Item.Status.GetDisplayName(Localizer)</MudChip>
                    </CellTemplate>
                </MagFlowTemplateColumn>
                <PropertyColumn T="StocktakeDTO" TProperty="DateTime" Title="@Localizer[Langs.StocktakeDate]"
                                Property="x => x.PlannedDate" Tag="@("PlannedDate")" Format="d" Sortable="true" Filterable="false" />
                <PropertyColumn T="StocktakeDTO" TProperty="DateTime" Title="@Localizer[Langs.StocktakeCreatedAt]"
                                Property="x => x.CreatedAt.ToLocalTime()" Tag="@("CreatedAt")" Format="g" Sortable="true" Filterable="false" />
                <MagFlowPropertyColumn T="StocktakeDTO" TProperty="string" TFilter="string"
                                       Title="@Localizer[Langs.StocktakeCreatedBy]" Property="x => x.CreatedByName"
                                       Tag="@("CreatedBy.FirstName | CreatedBy.LastName")" MagFlowSortable="true" />
            </Columns>
            <NoRecordsContent>
                @if (_loadFailed)
                {
                    <MudAlert Severity="Severity.Error">@Localizer[Langs.StocktakesLoadFailed]</MudAlert>
                }
                else
                {
                    <MudText Class="pa-4">@Localizer[Langs.NoStocktakes]</MudText>
                }
            </NoRecordsContent>
        </MagFlowDataGrid>
    </Authorized>
</AuthorizeView>
