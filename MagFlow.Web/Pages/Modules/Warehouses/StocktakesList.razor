@using MagFlow.BLL.Helpers
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.DataGrid
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inherits AuthComponentBase

<AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_READ">
    <Authorized Context="readContext">
        <MagFlowDataGrid @ref="_stocktakesDataGrid" T="StocktakeDTO" ServerData="ServerReloadStocktakes" DataGridId="@GridId" OnRowClicked="OpenStocktake"
>
            <ToolBarContent>
                <MudText Typo="Typo.subtitle1" Style="font-family: Inter, sans-serif; font-weight: 500;">@Localizer[Langs.Inventories]</MudText>
                <MudSpacer />
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_ADD" Context="addContext">
                    <Authorized>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_openingDialog"
                                   OnClick="PrepareStocktake" Class="mr-2">@Localizer[Langs.StocktakePrepareTitle]</MudButton>
                    </Authorized>
                </AuthorizeView>
                <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Outlined.Refresh"
                               OnClick="Refresh" Class="mr-2" />
            </ToolBarContent>
            <Columns>
                <MagFlowPropertyColumn T="StocktakeDTO" TProperty="string" TFilter="string"
                                       Title="@Localizer[Langs.Code]" Property="x => x.Code" Tag="@(nameof(StocktakeDTO.Code))" MagFlowSortable="true" />
                @if (!WarehouseId.HasValue)
                {
                    <MagFlowPropertyColumn T="StocktakeDTO" TProperty="string" TFilter="string"
                                           Title="@Localizer[Langs.WarehouseSelector]" Property="x => x.WarehouseName"
                                           Tag="@("Warehouse.Name")" MagFlowSortable="true" />
                }
                <MagFlowTemplateColumn T="StocktakeDTO" TFilter="Enums.StocktakeType"
                                       Title="@Localizer[Langs.StocktakeType]" Tag="@("Type")">
                    <CellTemplate>@context.Item.Type.GetDisplayName(Localizer)</CellTemplate>
                </MagFlowTemplateColumn>
                <MagFlowTemplateColumn T="StocktakeDTO" TFilter="Enums.EntityStatus" Title="@Localizer[Langs.Status]"
                                       Tag="@("Status")" IncludedEnumValues="@(new[] { Enums.EntityStatus.Prepared, Enums.EntityStatus.AwaitingApproval, Enums.EntityStatus.InProgress, Enums.EntityStatus.Confirmed, Enums.EntityStatus.Canceled, Enums.EntityStatus.Unknown })">
                    <CellTemplate>
                        <MudChip T="string" Color="@StocktakeStatusColor(context.Item.Status)" Size="Size.Medium" Variant="Variant.Filled" Class="m-0">@context.Item.Status.GetDisplayName(Localizer)</MudChip>
                    </CellTemplate>
                </MagFlowTemplateColumn>
                <TemplateColumn T="StocktakeDTO" Title="@Localizer[Langs.StocktakeAgreement]"
                                Sortable="false" Filterable="false" HeaderStyle="width: 22%;" CellStyle="width: 22%;">
                    <CellTemplate>
                        <div class="stocktake-agreement">
                            <MudProgressLinear Value="@((double)context.Item.AgreementPercent)" Color="Color.Primary"
                                               Style="--mud-palette-primary: #ff4081; width: 100%; height: .375rem; border-radius: 1rem;" />
                            <MudText Typo="Typo.body2">@($"{context.Item.AgreementPercent:0.#}%")</MudText>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn T="StocktakeDTO" TProperty="DateTime" Title="@Localizer[Langs.StocktakeDate]"
                                Property="x => x.PlannedDate" Tag="@("PlannedDate")" Format="d" Sortable="true" Filterable="false" />
                <TemplateColumn T="StocktakeDTO" Title="@Localizer[Langs.StocktakeConfirmedAt]"
                                Tag="@("ConfirmedAt")" Sortable="true" Filterable="false" SortBy="x => x.ConfirmedAt">
                    <CellTemplate>@(context.Item.ConfirmedAt?.ToLocalTime().ToString("g") ?? "—")</CellTemplate>
                </TemplateColumn>
                <MagFlowPropertyColumn T="StocktakeDTO" TProperty="string" TFilter="string"
                                       Title="@Localizer[Langs.User]" Property="x => x.CreatedByName"
                                       Tag="@("CreatedBy.FirstName | CreatedBy.LastName")" MagFlowSortable="true" />
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4">@Localizer[Langs.NoStocktakes]</MudText>
            </NoRecordsContent>
        </MagFlowDataGrid>
    </Authorized>
</AuthorizeView>
