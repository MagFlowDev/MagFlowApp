@using FluentValidation
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.BLL.Helpers
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Shared.Models.Enumerators
@using MagFlow.Shared.Models.FormModels
@using MagFlow.Shared.Validators.Company
@using MagFlow.Shared.Validators.Resources
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.TreeViews
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IWarehouseService WarehouseService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<Validations> Validations
@inherits AuthComponentBase

<EditForm EditContext="_context" Context="locationsForm" class="d-flex flex-column align-items-start w-100" style="max-width: 590px; min-height: 0; gap: 24px; padding-right: 40px; margin-top: 24px; padding-bottom: 24px;">
    <div class="d-flex justify-content-between w-100 align-items-center">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 500">@Localizer[Langs.WarehouseSectors]</MudText>
        <div class="d-flex h-100" style="gap: 9px">
            <MudButton Disabled="EditingDisabled" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddSector">@Localizer[Langs.AddSector]</MudButton>
            <LoadingButton Disabled="EditingDisabled" Variant="Variant.Outlined" Loading="_loading" StartIcon="@Icons.Material.Outlined.TableRows" OnClick="@(async () => await DefineRows())">@Localizer[Langs.DefineRows]</LoadingButton>
        </div>
    </div>
    <div class="d-flex flex-column w-100 align-items-start justify-content-start" style="flex: 1 1 0; min-height: 0; overflow-y: auto; padding-right: 12px; scrollbar-gutter: stable; box-sizing: border-box;">
        @if (_warehouseTreeItems.Count > 0)
        {
            <MudTreeView Items="_warehouseTreeItems" @bind-SelectedValues="_selectedValues" ReadOnly Class="w-100" Style="padding-right: 12px; box-sizing: border-box;">
                <ItemTemplate Context="item">
                    @{
                        var presenter = item as WarehouseTreeViewItem;
                    }
                    <MudTreeViewItem @bind-Expanded="@item.Expanded" Items="@item.Children" Value="@item.Value" Icon="@item.Icon" ReadOnly>
                        <BodyContent>
                            <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; width: 100%">
                                @if (presenter?.StorageType == Enums.WarehouseStorageType.Sector)
                                {
                                    var sector = presenter.GetSectorDTO()!;
                                    <MudTextField T="string" Disabled="EditingDisabled" Variant="Variant.Outlined"
                                                  Label="@Localizer[Langs.Name]" Margin="Margin.Dense"
                                                  @bind-Value="sector.Name" @bind-Value:after="@(() => { item.Text = sector.Name; })"
                                                  For="@(() => sector.Name)" />
                                }
                                else if (presenter?.StorageType == Enums.WarehouseStorageType.Row)
                                {
                                    var row = presenter.GetRowDTO()!;
                                    <MudTextField T="string" Disabled="EditingDisabled" Variant="Variant.Outlined"
                                                  Label="@Localizer[Langs.Name]" Margin="Margin.Dense"
                                                  @bind-Value="row.Name" @bind-Value:after="@(() => { item.Text = row.Name; })"
                                                  For="@(() => row.Name)" />
                                }
                                else if (presenter?.StorageType == Enums.WarehouseStorageType.Slot)
                                {
                                    var slot = presenter.GetSlotDTO()!;
                                    <MudTextField T="string" Disabled="EditingDisabled" Variant="Variant.Outlined"
                                                  Label="@Localizer[Langs.Name]" Margin="Margin.Dense"
                                                  @bind-Value="slot.Name" @bind-Value:after="@(() => { item.Text = slot.Name; })"
                                                  For="@(() => slot.Name)" />
                                }
                                <div style="justify-self: end;">
                                    <MudIconButton Disabled="EditingDisabled" Icon="@Icons.Material.Outlined.RemoveCircleOutline" Color="Color.Error" OnClick="@(() => RemoveStorage(presenter))" />
                                </div>
                            </div>
                        </BodyContent>
                    </MudTreeViewItem>
                    @if (presenter?.StorageType == Enums.WarehouseStorageType.Sector && (presenter.Children == null || presenter.Children.Count == 0 || presenter.Expanded == true))
                    {
                        <div class="w-100 d-flex align-items-center justify-content-start" style="gap: 8px">
                            <MudButton Disabled="EditingDisabled" Size="Size.Small" Variant="Variant.Outlined" Class="ml-12" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => AddRow(presenter)">@Localizer[Langs.AddRow]</MudButton>
                            <MudButton Disabled="EditingDisabled" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.TableRows" OnClick="() => DefineSlots(presenter)">@Localizer[Langs.DefineSlots]</MudButton>
                        </div>
                    }
                    else if (presenter?.StorageType == Enums.WarehouseStorageType.Row && (presenter.Children == null || presenter.Children.Count == 0 || presenter.Expanded == true))
                    {
                        <div class="w-100 d-flex align-items-center justify-content-end">
                            <MudButton Disabled="EditingDisabled" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => AddSlot(presenter)">@Localizer[Langs.AddSlot]</MudButton>
                        </div>
                    }
                </ItemTemplate>
            </MudTreeView>
        }
        else
        {
            <div class="d-flex w-100 mud-height-full align-items-center justify-content-center" style="gap: 16px">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Medium" Style="color: var(--mud-palette-text-disabled)" />
                <MudText Typo="Typo.h6" Style="font-weight: 600; color: var(--mud-palette-text-disabled)">@Localizer[Langs.NoSectorsAdded]</MudText>
            </div>
        }
    </div>
    <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_EDIT" Context="authorizedContext">
        <Authorized>
            <div class="d-flex justify-content-end w-100">
                <LoadingButton Loading="_saving" Disabled="ControlsDisabled" Color="Color.Primary"
                               Variant="Variant.Filled" OnClick="Submit">@Localizer[Langs.Save]</LoadingButton>
            </div>
        </Authorized>
    </AuthorizeView>
</EditForm>

@code {
    [CascadingParameter(Name = "Warehouse")]
    WarehouseDTO? _warehouse { get; set; }

    [Parameter]
    public EventCallback<WarehouseDTO> OnWarehouseUpdated { get; set; }

    [Parameter]
    public bool Submitting { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private IValidator _validator;
    private WarehouseFormModel _model;
    private EditContext _context;
    private ValidationMessageStore _messageStore;
    private bool _loading;

    private List<TreeItemData<int>> _warehouseTreeItems { get; set; } = new();
    private IReadOnlyCollection<int> _selectedValues { get; set; }

    private WarehouseDTO? _loadedWarehouse;
    private bool _saving;
    private bool _reloadRequired;
    private bool EditingDisabled => ControlsDisabled || _reloadRequired;
    private bool ControlsDisabled => IsBusy || Submitting || _loading || _saving ||
        !HasModulePermission("Warehouses", PermissionFlags.Edit);

    private int tempId = -1;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _model = new WarehouseFormModel();
        _context = new EditContext(_model);
        _validator = new WarehouseFormValidator(Validations);
        _messageStore = new ValidationMessageStore(_context);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (_warehouse != null && !ReferenceEquals(_warehouse, _loadedWarehouse))
        {
            _loadedWarehouse = _warehouse;
            _reloadRequired = false;
            _warehouseTreeItems.Clear();
            _messageStore.Clear();
            tempId = -1;
            _warehouse.Sectors?.ForEach(sector =>
             {
                 var newSector = new WarehouseTreeViewItem(sector.Id, sector.Name, Enums.WarehouseStorageType.Sector);
                 sector.Rows?.ForEach(row =>
                 {
                     var newRow = new WarehouseTreeViewItem(row.Id, row.Name, Enums.WarehouseStorageType.Row, newSector.Value);
                     row.Slots?.ForEach(slot =>
                     {
                         var newSlot = new WarehouseTreeViewItem(slot.Id, slot.Name, Enums.WarehouseStorageType.Slot, newRow.Value);
                         newRow.AddChildren(newSlot);
                     });
                     newSector.AddChildren(newRow);
                 });
                 _warehouseTreeItems.Add(newSector);
             });
        }
    }

    private async Task Submit()
    {
        if (ControlsDisabled || _warehouse == null)
            return;

        if (!HasModulePermission("Warehouses", PermissionFlags.Edit))
            return;

        try
        {
            _saving = true;

            if (!_reloadRequired)
            {
                FillModel();
                var isValid = await _messageStore.IsFormValid(_validator, _model);
                _context.NotifyValidationStateChanged();

                if (!isValid)
                {
                    foreach (var sector in _warehouseTreeItems)
                    {
                        sector.Expanded = true;
                        if (sector.Children != null)
                            foreach (var row in sector.Children)
                                row.Expanded = true;
                    }
                    return;
                }

                var result = await WarehouseService.UpdateLocations(_warehouse.Id, _model.Sectors);
                if (result != WarehouseLocationsSaveResult.Success)
                {
                    var message = result == WarehouseLocationsSaveResult.LocationInUse
                        ? Localizer["WarehouseLocationInUse"]
                        : Localizer[Langs.ErrorOccured];
                    Snackbar.Add(message, MudBlazor.Severity.Error);
                    return;
                }
                _reloadRequired = true;
            }

            var refreshed = await WarehouseService.GetWarehouse(_warehouse.Id);
            if (refreshed == null)
            {
                Snackbar.Add(Localizer["WarehouseLocationsReloadRequired"], MudBlazor.Severity.Warning);
                return;
            }

            await OnWarehouseUpdated.InvokeAsync(refreshed);
            Snackbar.Add(Localizer[Langs.ChangesSaved], MudBlazor.Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private void FillModel()
    {
        if (_warehouse == null)
            return;

        _model.GeneralInformation.Name = _warehouse.Name;
        _model.GeneralInformation.Type = _warehouse.Type;

        var sectors = _warehouseTreeItems
               .Select(x => ((WarehouseTreeViewItem)x).GetSectorDTO())
               .Where(x => x != null).Select(x => x!)
               .ToList();
        _model.Sectors = sectors;
    }


    private void AddSector()
    {
        if (_saving || _reloadRequired || !HasModulePermission("Warehouses", PermissionFlags.Edit))
            return;

        var sectorBaseName = Localizer[Langs.Sector];
        var sectorNumber = _warehouseTreeItems.Count + 1;
        while (_warehouseTreeItems.Any(x => x.Text == $"{sectorBaseName} {sectorNumber}"))
        {
            sectorNumber++;
            if (sectorNumber > 1000)
                break;
        }

        _warehouseTreeItems.Add(new WarehouseTreeViewItem(tempId--, $"{sectorBaseName} {sectorNumber}", Enums.WarehouseStorageType.Sector));
    }

    private void AddRow(WarehouseTreeViewItem sector)
    {
        if (_saving || _reloadRequired || !HasModulePermission("Warehouses", PermissionFlags.Edit))
            return;

        var rowBaseName = Localizer[Langs.Row];
        var rowNumber = (sector.Children?.Count ?? 0) + 1;
        while (sector.Children?.Any(x => x.Text == $"{rowBaseName} {rowNumber}") == true)
        {
            rowNumber++;
            if (rowNumber > 1000)
                break;
        }

        sector.Children ??= new List<WarehouseTreeViewItem>();
        sector.AddChildren(new WarehouseTreeViewItem(tempId--, $"{rowBaseName} {rowNumber}", Enums.WarehouseStorageType.Row, sector.Value));
        sector.Expanded = true;
    }

    private void AddSlot(WarehouseTreeViewItem row)
    {
        if (_saving || _reloadRequired || !HasModulePermission("Warehouses", PermissionFlags.Edit))
            return;

        var slotBaseName = Localizer[Langs.Slot];
        var slotNumber = (row.Children?.Count ?? 0) + 1;
        while (row.Children?.Any(x => x.Text == $"{slotBaseName} {slotNumber}") == true)
        {
            slotNumber++;
            if (slotNumber > 1000)
                break;
        }

        row.Children ??= new List<WarehouseTreeViewItem>();
        row.AddChildren(new WarehouseTreeViewItem(tempId--, $"{slotBaseName} {slotNumber}", Enums.WarehouseStorageType.Slot, row.Value));
        row.Expanded = true;
    }


    private void RemoveStorage(WarehouseTreeViewItem? storage)
    {
        if (_saving || _reloadRequired || !HasModulePermission("Warehouses", PermissionFlags.Edit))
            return;

        if (storage == null)
            return;

        if (storage.StorageType == Enums.WarehouseStorageType.Sector)
        {
            _warehouseTreeItems.Remove(storage);
        }
        else if (storage.StorageType == Enums.WarehouseStorageType.Row)
        {
            var parent = _warehouseTreeItems.FirstOrDefault(x => ((WarehouseTreeViewItem)x) != null && ((WarehouseTreeViewItem)x).Value == storage.ParentId) as WarehouseTreeViewItem;
            if (parent == null)
                return;
            parent.RemoveChildren(storage);
        }
        else if (storage.StorageType == Enums.WarehouseStorageType.Slot)
        {
            WarehouseTreeViewItem? parent = null;
            foreach (var sector in _warehouseTreeItems)
            {
                parent = sector.Children?.FirstOrDefault(x => ((WarehouseTreeViewItem)x) != null && ((WarehouseTreeViewItem)x).Value == storage.ParentId) as WarehouseTreeViewItem;
                if (parent != null)
                    break;
            }
            if (parent == null)
                return;
            parent.RemoveChildren(storage);
        }
    }

    private async Task DefineRows()
    {
        if (ControlsDisabled)
            return;

        try
        {
            IsBusy = true;
            _loading = true;

            var sectors = _warehouseTreeItems.ToDictionary(x => ((WarehouseTreeViewItem)x).Value, x => x.Text ?? Localizer[Langs.Sector].Value);
            if (sectors == null || sectors.Count == 0)
                return;

            var parameters = new DialogParameters<DefineRowsDialog<int>> { { x => x.Sectors, sectors } };
            var dialog = await DialogService.ShowAsync<DefineRowsDialog<int>>(Localizer[Langs.DefineRows], parameters);
            var confirmation = await dialog.Result;

            if (confirmation != null && !confirmation.Canceled)
            {
                if (confirmation.Data is Tuple<IReadOnlyCollection<int>, int> data)
                {
                    var sectorIds = data.Item1.ToList();
                    var rowNumber = data.Item2;
                    if (rowNumber <= 0)
                        return;

                    foreach (var sectorId in sectorIds)
                    {
                        var sector = _warehouseTreeItems.FirstOrDefault(x => ((WarehouseTreeViewItem)x)?.Value == sectorId) as WarehouseTreeViewItem;
                        if (sector == null)
                            continue;

                        sector.Children = new List<ITreeItemData<int>>();
                        for (int i = 0; i < rowNumber; i++)
                            AddRow(sector);
                    }
                }
            }
        }
        finally
        {
            _loading = false;
            IsBusy = false;
        }
    }

    private async Task DefineSlots(WarehouseTreeViewItem sector)
    {
        if (ControlsDisabled)
            return;

        try
        {
            IsBusy = true;
            _loading = true;

            var rows = sector?.Children?.ToDictionary(x => ((WarehouseTreeViewItem)x).Value, x => x.Text ?? Localizer[Langs.Row].Value);
            if (rows == null || rows.Count == 0)
                return;

            var parameters = new DialogParameters<DefineSlotsDialog<int>> { { x => x.Rows, rows } };
            var dialog = await DialogService.ShowAsync<DefineSlotsDialog<int>>(Localizer[Langs.DefineSlots], parameters);
            var confirmation = await dialog.Result;

            if (confirmation != null && !confirmation.Canceled)
            {
                if (confirmation.Data is Tuple<IReadOnlyCollection<int>, int> data)
                {
                    var rowIds = data.Item1.ToList();
                    var slotNumber = data.Item2;
                    if (slotNumber <= 0)
                        return;

                    foreach (var rowId in rowIds)
                    {
                        var row = sector?.Children?.FirstOrDefault(x => ((WarehouseTreeViewItem)x)?.Value == rowId) as WarehouseTreeViewItem;
                        if (row == null)
                            continue;

                        row.Children = new List<ITreeItemData<int>>();
                        for (int i = 0; i < slotNumber; i++)
                            AddSlot(row);
                    }
                }
            }
        }
        finally
        {
            _loading = false;
            IsBusy = false;
        }
    }
}
