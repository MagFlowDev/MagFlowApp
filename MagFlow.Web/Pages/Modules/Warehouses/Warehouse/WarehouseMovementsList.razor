@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor

@inject IStockMovementService StockMovementService
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_stockMovementsDataGrid" T="StockMovementDTO" ServerData="ServerReloadStockMovements" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WAREHOUSE_STOCK_MOVEMENTS_LIST">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.WarehouseMovementsList]</MudText>
        <MudSpacer />
        <MudIconButton Color="Color.Primary" OnClick="_stockMovementsDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        @* Movement type *@
        <MagFlowTemplateColumn T="StockMovementDTO" TFilter="Enums.StockMovementType" Title="@Localizer[Langs.MovementType]" Tag="@($"{nameof(StockMovementDTO.MovementType)}")" ExcludedEnumValues="@(new[] { Enums.StockMovementType.Unknown })">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Variant="Variant.Filled" Style="@($"{context.Item.MovementType.ToColor()}")">@context.Item.MovementType.GetDisplayName(Localizer)</MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>

        @* From location *@
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.FromWarehouse]" MagFlowSortable="true"
                               Property="@(warehouse => (warehouse.SourceLocation == null || warehouse.SourceLocation.Warehouse == null ? "-" : warehouse.SourceLocation.Warehouse.Name))"
                               Tag="@($"{nameof(StockMovementDTO.SourceLocation)}.{nameof(StockMovementDTO.SourceLocation.Warehouse)}.{nameof(StockMovementDTO.SourceLocation.Warehouse.Name)}")" />
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Location]" MagFlowSortable="true"
                               Property="@(warehouse => (warehouse.SourceLocation == null || warehouse.SourceLocation.Sector == null ? "-" : 
                               $"{warehouse.SourceLocation.Sector.Name}{(warehouse.SourceLocation.Row == null ? "" : $"-{warehouse.SourceLocation.Row.Name}")}{(warehouse.SourceLocation.Slot == null ? "" : $"-{warehouse.SourceLocation.Slot.Name}")}"))"
                               Tag="@($"{nameof(StockMovementDTO.SourceLocation)}.{nameof(StockMovementDTO.SourceLocation.Sector)}.{nameof(StockMovementDTO.SourceLocation.Sector.Name)}")" />

        @* To location *@
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.ToWarehouse]" MagFlowSortable="true"
                               Property="@(warehouse => (warehouse.TargetLocation == null || warehouse.TargetLocation.Warehouse == null ? "-" : warehouse.TargetLocation.Warehouse.Name))"
                               Tag="@($"{nameof(StockMovementDTO.TargetLocation)}.{nameof(StockMovementDTO.TargetLocation.Warehouse)}.{nameof(StockMovementDTO.TargetLocation.Warehouse.Name)}")" />
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Location]" MagFlowSortable="true"
                               Property="@(warehouse => (warehouse.TargetLocation == null || warehouse.TargetLocation.Sector == null ? "-" :
                               $"{warehouse.TargetLocation.Sector.Name}{(warehouse.TargetLocation.Row == null ? "" : $"-{warehouse.TargetLocation.Row.Name}")}{(warehouse.TargetLocation.Slot == null ? "" : $"-{warehouse.TargetLocation.Slot.Name}")}"))"
                               Tag="@($"{nameof(StockMovementDTO.TargetLocation)}.{nameof(StockMovementDTO.TargetLocation.Sector)}.{nameof(StockMovementDTO.TargetLocation.Sector.Name)}")" />

        @* Contractor *@
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Contractor]" MagFlowSortable="true" Property="@(warehouse => (warehouse.Contractor != null ? warehouse.Contractor.Name : "-"))" Tag="@($"{nameof(StockMovementDTO.Contractor)}.{nameof(StockMovementDTO.Contractor.Name)}")" />

        @* Item *@
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.ProductName]" MagFlowSortable="true" 
                               Property="warehouse => (warehouse.Item != null && warehouse.Item.Product != null ? warehouse.Item.Product.Name : string.Empty)" 
                               Tag="@($"{nameof(StockMovementDTO.Item)}.{nameof(StockMovementDTO.Item.Product)}.{nameof(StockMovementDTO.Item.Product.Name)}")" />
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.WareCode]" MagFlowSortable="true"
                               Property="warehouse => (warehouse.Item != null ? warehouse.Item.Code : string.Empty)"
                               Tag="@($"{nameof(StockMovementDTO.Item)}.{nameof(StockMovementDTO.Item.Code)}")" />
        <MagFlowTemplateColumn T="StockMovementDTO" TFilter="string" Title="@Localizer[Langs.Quantity]" MagFlowSortable="true" Tag="@($"{nameof(StockMovementDTO.Quantity)}")">
            <CellTemplate>
                @($"{context.Item.Quantity:0.##} {context.Item.Item?.Unit?.Symbol}")
            </CellTemplate>
        </MagFlowTemplateColumn>

        @* User *@
        <MagFlowPropertyColumn T="StockMovementDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.User]" MagFlowSortable="true"
                               Property="@(warehouse => (warehouse.User != null ? $"{warehouse.User.FirstName} {warehouse.User.LastName}" : "-"))"
                               Tag="@($"{nameof(StockMovementDTO.User)}.{nameof(StockMovementDTO.User.FirstName)}")" />

        <MagFlowPropertyColumn T="StockMovementDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Date]" Property="@(warehouse => warehouse.Date.ToLocalTime().ToShortDateString())" Tag="@($"{nameof(StockMovementDTO.Date)}")" />

    </Columns>
</MagFlowDataGrid>

@code {
    [CascadingParameter(Name = "Warehouse")]
    WarehouseDTO? _warehouse { get; set; }

    MudDataGrid<StockMovementDTO> _stockMovementsDataGrid;

    private async Task<GridData<StockMovementDTO>> ServerReloadStockMovements(GridState<StockMovementDTO> state, CancellationToken token)
    {
        if(_warehouse == null)
        {
            return new GridData<StockMovementDTO>()
                {
                    Items = [],
                    TotalItems = 0
                };
        }

        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        string? sortBy = sortDefinition?.SortBy;
        if (Guid.TryParse(sortBy, out _))
        {
            var column = _stockMovementsDataGrid.RenderedColumns.FirstOrDefault(c => c.PropertyName == sortBy);
            sortBy = column?.Tag?.ToString();
        }
        sortBy = sortBy ?? nameof(StockMovementDTO.Id);
        var queryOptions = new MagFlow.Shared.Models.QueryOptions<MagFlow.Domain.CompanyScope.StockMovement>()
        {
            PageNumber = state.Page,
            PageSize = state.PageSize,
            SortBy = sortBy,
            Descending = sortDefinition?.Descending == true,
            Includes = stock => stock
                .Include(x => x.SourceWarehouse).Include(x => x.SourceSector).Include(x => x.SourceRow).Include(x => x.SourceSlot)
                .Include(x => x.TargetWarehouse).Include(x => x.TargetSector).Include(x => x.TargetRow).Include(x => x.TargetSlot)
                .Include(x => x.Item).ThenInclude(y => y.Product)
                .Include(x => x.Item).ThenInclude(y => y.DefaultUnit)
                .Include(x => x.CreatedBy)
        };
        queryOptions.ApplyFilters(state.FilterDefinitions);
        queryOptions.ColumnFilters ??= new List<ColumnFilter>();
        queryOptions.ColumnFilters.Add(ColumnFilter.Create(
            $"{nameof(MagFlow.Domain.CompanyScope.StockMovement.SourceWarehouseId)} | {nameof(MagFlow.Domain.CompanyScope.StockMovement.TargetWarehouseId)}",
            MagFlow.Shared.Models.FilterOperator.Equals, _warehouse.Id));
        var response = await StockMovementService.GetManyAsync(queryOptions);

        return new GridData<StockMovementDTO>
        {
            Items = response.Elements,
            TotalItems = response.TotalCount,
        };
    }
}
