@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IWarehouseService WarehouseService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_warehousesDataGrid" T="WarehouseDTO" ServerData="ServerReloadWarehouses" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WAREHOUSES_ARCHIVE" OnRowClicked="OpenWarehouseDetails" MultiSelection="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.WarehousesList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_EDIT">
            <Authorized>
                <LoadingButton Loading="_loadingRestoreMany" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.RestartAlt" Class="mr-2" OnClick="RestoreWarehouses">@Localizer[Langs.Restore]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_warehousesDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="WarehouseDTO" HeaderStyle="width: 1%" />
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Name]" MagFlowSortable="true" Property="warehouse => warehouse.Name" Tag="@($"{nameof(WarehouseDTO.Name)}")" />
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Code]" MagFlowSortable="true" Property="warehouse => warehouse.Code" Tag="@($"{nameof(WarehouseDTO.Code)}")" />
        <MagFlowTemplateColumn T="WarehouseDTO" TFilter="Enums.EntityStatus" Title="@Localizer[Langs.Status]" Tag="@($"{nameof(WarehouseDTO.Status)}")" IncludedEnumValues="@(new[] { Enums.EntityStatus.Active })">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Variant="Variant.Filled" Color="@context.Item.Status.ToColor()">@context.Item.Status.GetDisplayName(Localizer)</MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="Enums.WarehouseType" Title="@Localizer[Langs.Type]" Property="warehouse => warehouse.Type.GetDisplayName(Localizer)" Tag="@($"{nameof(WarehouseDTO.Type)}")" ExcludedEnumValues="@(new[] { Enums.WarehouseType.Unknown })" />
        <MagFlowTemplateColumn T="WarehouseDTO" Title="Obłożenie" TFilter="string" Filterable="false">
            <CellTemplate>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowActionColumn T="WarehouseDTO" Title="@Localizer[Langs.Actions]">
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_EDIT">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Restore]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingRestore(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.RestartAlt" OnClick="() => RestoreWarehouse(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>