@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.DTOs.CoreScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IWarehouseService WarehouseService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject ILocalCacheService LocalCacheService
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_warehousesDataGrid" T="WarehouseDTO" ServerData="ServerReloadWarehouses" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WAREHOUSES_LIST" OnRowClicked="OpenWarehouseDetails" MultiSelection="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.WarehousesList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_EDIT">
            <Authorized>
                <LoadingButton Loading="_loadingChangeStatus" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.MoveUp" Class="mr-2" OnClick="ChangeStatus">@Localizer[Langs.ChangeStatus]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_DELETE">
            <Authorized>
                <LoadingButton Loading="_loadingDeleteMany" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Delete" Class="mr-2" OnClick="DeleteWarehouses">@Localizer[Langs.Delete]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_ADD">
            <Authorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mr-2" OnClick="OpenAddWarehouseWizard">@Localizer[Langs.AddWarehouse]</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_warehousesDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="WarehouseDTO" HeaderStyle="width: 1%" />
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Name]" MagFlowSortable="true" Property="warehouse => warehouse.Name" />
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Code]" MagFlowSortable="true" Property="warehouse => warehouse.Code" />
        <MagFlowTemplateColumn T="WarehouseDTO" TFilter="string" Title="@Localizer[Langs.Status]">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Variant="Variant.Filled" Color="@context.Item.Status.ToColor()">@context.Item.Status.GetDisplayName(Localizer)</MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="WarehouseDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Type]" Property="warehouse => warehouse.Type.GetDisplayName(Localizer)" />
        <MagFlowTemplateColumn T="WarehouseDTO" Title="Obłożenie" TFilter="string">
            <CellTemplate>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowActionColumn T="WarehouseDTO" Title="@Localizer[Langs.Actions]" >
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_READ">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Open]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.OpenInNew" OnClick="() => OpenWarehouseDetails(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_ADD">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.CreateCopy]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" OnClick="() => OpenAddWarehouseWizard(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WAREHOUSES_DELETE">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Delete]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingDelete(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => DeleteWarehouse(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>