@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IProductService ProductService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject ILocalCacheService LocalCacheService
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_productsDataGrid" T="ProductDTO" ServerData="ServerReloadProducts" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WARES_PRODUCTS_LIST" OnRowClicked="OpenProductDetails" MultiSelection="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.ProductsList]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_DELETE">
            <Authorized>
                <LoadingButton Loading="_loadingDeleteMany" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Delete" Class="mr-2" OnClick="DeleteProducts">@Localizer[Langs.Delete]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_ADD">
            <Authorized>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mr-2" OnClick="OpenAddProductWizard">@Localizer[Langs.AddProduct]</MudButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_productsDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ProductDTO" HeaderStyle="width: 1%" />
        <MagFlowPropertyColumn T="ProductDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Name]" MagFlowSortable="true" Property="product => product.Name" Tag="@($"{nameof(ProductDTO.Name)}")" />
        <MagFlowPropertyColumn T="ProductDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Code]" MagFlowSortable="true" Property="product => product.Code" Tag="@($"{nameof(ProductDTO.Code)}")" />
        <MagFlowPropertyColumn T="ProductDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Category]" Property="@(product => (product.Category != null ? product.Category.Name : string.Empty))" Tag="@($"{nameof(ProductDTO.Category)}.{nameof(ProductDTO.Category.Name)}")" />
        <MagFlowPropertyColumn T="ProductDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Type]" Property="@(product => (product.Type != null ? product.Type.Name : string.Empty))" Tag="@($"{nameof(ProductDTO.Type)}.{nameof(ProductDTO.Type.Name)}")" />
        <MagFlowPropertyColumn T="ProductDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.UnitShort]" Property="@(product => (product.Unit != null ? product.Unit.Name : string.Empty))" Tag="@($"{nameof(ProductDTO.Unit)}.{nameof(ProductDTO.Unit.Name)}")" />
        <MagFlowTemplateColumn T="ProductDTO" TFilter="string" Title="@Localizer[Langs.PurchasePrice]" Tag="@($"{nameof(ProductDTO.PurchasePrice)}")">
            <CellTemplate>
                @($"{context.Item.PurchasePrice:N2} {context.Item.Currency.GetDisplayName(Localizer)}")
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowTemplateColumn T="ProductDTO" TFilter="string" Title="@Localizer[Langs.SellingPrice]" Tag="@($"{nameof(ProductDTO.SellingPrice)}")">
            <CellTemplate>
                @($"{context.Item.SellingPrice:N2} {context.Item.Currency.GetDisplayName(Localizer)}")
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowTemplateColumn T="ProductDTO" TFilter="string" Title="@Localizer[Langs.TaxRate]" Tag="@($"{nameof(ProductDTO.TaxRate)}")">
            <CellTemplate>
                @(context.Item.TaxRate.HasValue ? $"{context.Item.TaxRate?.ToDecimal():0.##}%" : string.Empty)
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowActionColumn T="ProductDTO" Title="@Localizer[Langs.Actions]">
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_READ">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Open]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.OpenInNew" OnClick="() => OpenProductDetails(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_ADD">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.CreateCopy]" Delay="@Constants.Tooltip.DELAY">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" OnClick="() => OpenAddProductWizard(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_DELETE">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Delete]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingDelete(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => DeleteProduct(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>