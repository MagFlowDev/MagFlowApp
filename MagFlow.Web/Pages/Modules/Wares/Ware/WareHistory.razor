@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IItemService ItemService
@inherits AuthComponentBase

<div class="d-flex flex-column align-items-start w-100" style="max-width: 800px; min-height: 0; gap: 16px; padding-right: 40px; margin-top: 24px;">
    @if (_item != null)
    {
        <MagFlowDataGrid @ref="_historyDataGrid" T="EntityHistoryDTO" ServerData="ServerReloadHistory" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WARES_WARE_HISTORY" Filterable="false" Class="align-self-stretch mud-table-overflow-hidden flex-grow-1 dg-fixed-pager striped-grid overflow-x-auto my-2 shadow-none">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Localizer[Langs.History]</MudText>
                <MudSpacer />
                <MudIconButton Color="Color.Primary" OnClick="_historyDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
            </ToolBarContent>
            <Columns>
                <MagFlowPropertyColumn T="EntityHistoryDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Date]" MagFlowSortable="true" Property="history => history.OccurredAt.ToLocalTime().ToShortDateString()" Tag="@($"{nameof(EntityHistoryDTO.OccurredAt)}")" />
                <MagFlowPropertyColumn T="EntityHistoryDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Description]" Property="history => history.EventType" Tag="@($"{nameof(EntityHistoryDTO.EventType)}")" />
                <MagFlowPropertyColumn T="EntityHistoryDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.User]" Property="@(history => (history.User != null ? $"{history.User.FirstName} {history.User.LastName}" : string.Empty))" Tag="@($"{nameof(EntityHistoryDTO.User)}.{nameof(EntityHistoryDTO.User.LastName)}")" />
            </Columns>
        </MagFlowDataGrid>
    }
</div>

@code {
    [CascadingParameter(Name = "Item")]
    ItemDTO? _item { get; set; }

    MudDataGrid<EntityHistoryDTO> _historyDataGrid;

    string? _searchString = null;

    private async Task<GridData<EntityHistoryDTO>> ServerReloadHistory(GridState<EntityHistoryDTO> state, CancellationToken token)
    {
        if (_item == null)
        {
            return new GridData<EntityHistoryDTO>
            {
                Items = new List<EntityHistoryDTO>(),
                TotalItems = 0,
            };
        }

        var sortDefinition = state.SortDefinitions.FirstOrDefault();
        string? sortBy = sortDefinition?.SortBy;
        if (Guid.TryParse(sortBy, out _))
        {
            var column = _historyDataGrid.RenderedColumns.FirstOrDefault(c => c.PropertyName == sortBy);
            sortBy = column?.Tag?.ToString();
        }
        sortBy = sortBy ?? nameof(EntityHistoryDTO.Id);
        var queryOptions = new QueryOptions<MagFlow.Shared.Models.Interfaces.IEntityHistory>()
        {
            PageNumber = state.Page,
            PageSize = state.PageSize,
            Search = _searchString,
            SortBy = sortBy,
            Descending = sortDefinition?.Descending == true
        };
        queryOptions.ApplyFilters(state.FilterDefinitions);
        var response = await ItemService.GetEntityHistory(_item.Id, Enums.HistoryEntityType.Item, queryOptions);
        return new GridData<EntityHistoryDTO>
        {
            Items = response.Elements,
            TotalItems = response.TotalCount,
        };
    }
}
