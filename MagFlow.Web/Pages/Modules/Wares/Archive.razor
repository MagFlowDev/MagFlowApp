@using MagFlow.BLL.Helpers
@using MagFlow.BLL.Services.Interfaces
@using MagFlow.Shared.DTOs.CompanyScope
@using MagFlow.Shared.Models
@using MagFlow.Web.Components.Buttons
@using MagFlow.Web.Components.DataGrid
@using MagFlow.Web.Helpers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IItemService ItemService
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inherits AuthComponentBase

<MagFlowDataGrid @ref="_itemsDataGrid" T="ItemDTO" ServerData="ServerReloadItems" DataGridId="@MagFlow.Shared.Constants.Identificators.DataGridID.WARES_ARCHIVE" OnRowClicked="OpenItemDetails" MultiSelection="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Localizer[Langs.Archive]</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_EDIT">
            <Authorized>
                <LoadingButton Loading="_loadingRestoreMany" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.RestartAlt" Class="mr-2" OnClick="RestoreItems">@Localizer[Langs.Restore]</LoadingButton>
            </Authorized>
        </AuthorizeView>
        <MudIconButton Color="Color.Primary" OnClick="_itemsDataGrid.ReloadServerData" Class="mr-2" Icon="@Icons.Material.Outlined.Refresh" />
    </ToolBarContent>
    <Columns>
        <SelectColumn T="ItemDTO" HeaderStyle="width: 1%" />
        <MagFlowPropertyColumn T="ItemDTO" TProperty="string" TFilter="string" Title="@Localizer[Langs.Name]" MagFlowSortable="true" Property="item => (item.Product != null ? item.Product.Name : string.Empty)" Tag="@($"{nameof(ItemDTO.Product)}.{nameof(ItemDTO.Product.Name)}")" />
        <MagFlowCodeColumn T="ItemDTO" MagFlowSortable="true" Title="@Localizer[Langs.Code]" Tag="@($"{nameof(ItemDTO.Code)}")" />
        <MagFlowTemplateColumn T="ItemDTO" TFilter="Enums.EntityStatus" Title="@Localizer[Langs.Status]" Tag="@($"{nameof(ItemDTO.Status)}")" IncludedEnumValues="@(new[] { Enums.EntityStatus.Deleted, Enums.EntityStatus.Used, Enums.EntityStatus.Released })">
            <CellTemplate>
                <MudChip T="string" Class="m-0" Variant="Variant.Filled" Color="@context.Item.Status.ToColor()">@context.Item.Status.GetDisplayName(Localizer)</MudChip>
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="ItemDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Type]" Property="item => (item.Product != null && item.Product.Type != null ? item.Product.Type.Name : string.Empty)" Tag="@($"{nameof(ItemDTO.Product)}.{nameof(ItemDTO.Product.Type)}.{nameof(ItemDTO.Product.Type.Name)}")" />
        <MagFlowPropertyColumn T="ItemDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.Category]" Property="item => (item.Product != null && item.Product.Category != null ? item.Product.Category.Name : string.Empty)" Tag="@($"{nameof(ItemDTO.Product)}.{nameof(ItemDTO.Product.Category)}.{nameof(ItemDTO.Product.Category.Name)}")" />
        <MagFlowTemplateColumn T="ItemDTO" TFilter="string" Title="@Localizer[Langs.Quantity]" Tag="@($"{nameof(ItemDTO.Quantity)}")">
            <CellTemplate>
                @($"{context.Item.Quantity:0.##} {context.Item.Unit?.Symbol}")
            </CellTemplate>
        </MagFlowTemplateColumn>
        <MagFlowPropertyColumn T="ItemDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.CreationDate]" Property="item => (item.CreatedAt.HasValue ? item.CreatedAt.Value.ToLocalTime().ToShortDateString() : string.Empty)" Tag="@($"{nameof(ItemDTO.CreatedAt)}")" />
        <MagFlowPropertyColumn T="ItemDTO" TFilter="string" TProperty="string" Title="@Localizer[Langs.StockRemovalDate]" Property="item => (item.RemovedAt.HasValue ? item.RemovedAt.Value.ToLocalTime().ToShortDateString() : string.Empty)" Tag="@($"{nameof(ItemDTO.RemovedAt)}")" />
        <MagFlowActionColumn T="ItemDTO" Title="@Localizer[Langs.Actions]">
            <CellTemplate>
                <AuthorizeView Policy="@MagFlow.Shared.Constants.Policies.Claims.WARES_EDIT">
                    <Authorized Context="authorizedContext">
                        <MudTooltip Text="@Localizer[Langs.Restore]" Delay="@Constants.Tooltip.DELAY">
                            <LoadingIconButton Loading="LoadingRestore(context.Item.Id)" Size="@Size.Small" Icon="@Icons.Material.Outlined.RestartAlt" OnClick="() => RestoreItem(context.Item)" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </CellTemplate>
        </MagFlowActionColumn>
    </Columns>
</MagFlowDataGrid>