@using MudBlazor

@inject IJSRuntime JS

<div class="d-flex flex-column w-100 flex-grow-1 px-4 pt-2" style="min-height: 0; gap: 16px;">
    <div class="d-flex flex-grow-1 flex-column align-items-center pt-8">
        <div class="d-flex flex-column flex-grow-1 w-100" style="gap: 8px; min-height: 0; flex: 1 1 0; max-width: 804px;">
            <div class="d-flex justify-content-between align-items-start">
                <MudText Typo="Typo.h5" Style="font-weight: 700">@Title</MudText>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Close" OnClick="@(async () => await JS.InvokeVoidAsync("history.back"))" />
            </div>
            <EditForm EditContext="@EditContext" class="flex-grow-1 d-flex flex-column h-100" style="min-height: 0;">
                @ChildContent
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; }
    [Parameter, EditorRequired] public EditContext EditContext { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }
}
