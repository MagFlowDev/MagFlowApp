{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "MagFlow.API/bin/Release/net10.0/MagFlow.API.dll",
            "MagFlow.BLL/bin/Release/net10.0/MagFlow.BLL.dll",
            "MagFlow.DAL/bin/Release/net10.0/MagFlow.DAL.dll",
            "MagFlow.Domain/bin/Release/net10.0/MagFlow.Domain.dll",
            "MagFlow.EF/bin/Release/net10.0/MagFlow.EF.dll",
            "MagFlow.Shared/bin/Release/net10.0/MagFlow.Shared.dll",
            "MagFlow.Web/bin/Release/net10.0/MagFlow.Web.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "MagFlowApp",
      "_appTitle": "MagFlowApp",
      "_enableSearch": true,
      "pdf": true
    }
  }
}